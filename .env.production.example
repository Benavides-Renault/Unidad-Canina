# Copiar a .env en el servidor y completar los valores vacíos.
# Los secretos y la contraseña inicial se entregan fuera de Git.
POSTGRES_DB=oryx
POSTGRES_USER=oryx
POSTGRES_PASSWORD=
APP_ENCRYPTION_KEY=
DEMO_MODE=false
ORYX_HOST=
ACME_EMAIL=
# Cambiar por la dirección de escucha elegida en el servidor.
HTTPS_BIND_ADDRESS=127.0.0.1
CADDY_CONFIG=./infra/Caddyfile
COOKIE_SECURE=true
ADMIN_MFA_REQUIRED=false
SESSION_TTL_HOURS=12
STORAGE_DRIVER=local
STORAGE_PATH=/data/files
UPLOAD_QUARANTINE_PATH=/data/files/.quarantine
STORAGE_QUOTA_MIB=10240
UPLOAD_SCANNER_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
