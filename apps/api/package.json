{
  "name": "@valkyr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "tsx --test ../../tests/unit.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "bootstrap": "tsx src/bootstrap.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "10.1.1",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
