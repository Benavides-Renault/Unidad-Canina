# Copiar a .env. Generar secretos propios; no hay contraseña de administrador predeterminada.
POSTGRES_DB=valkyr
POSTGRES_USER=valkyr
POSTGRES_PASSWORD=
# Ejecución NATIVA: postgres expuesto sólo por loopback en 5433 en Compose.
# Sustituir la contraseña y codificar caracteres reservados de URL (%40, %3A, ...).
DATABASE_URL=postgresql://valkyr:REEMPLAZAR@127.0.0.1:5433/valkyr?schema=public
# Nativo: credenciales separadas opcionales. El lanzador no las entrega a la API.
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=
BACKUP_ENABLED=false
BACKUP_DIRECTORY=./backups
BACKUP_STATUS_PATH=./.local/backup-status.json
# Ruta opcional de pg_dump/pg_restore para instalaciones portátiles.
PG_BIN=
DEMO_MODE=false
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4000
# 32 bytes aleatorios en hexadecimal; conservar con respaldo seguro de secretos.
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Activar en instalaciones definitivas. El conjunto de prueba usa contraseñas 1234 y MFA opcional.
ADMIN_MFA_REQUIRED=false
# Web Push: generar claves una vez con scripts/configure-push.mjs. Opt-in por navegador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Respaldo cifrado diario. Generar 32 bytes aleatorios; guardar una copia de esta clave fuera de la PC.
BACKUP_ENCRYPTION_KEY=
STORAGE_QUOTA_MIB=10240
UPLOAD_QUARANTINE_PATH=.private-quarantine
# Ruta absoluta de clamscan; si está definido, los fallos del analizador retienen el archivo.
UPLOAD_SCANNER_PATH=
STORAGE_DRIVER=local
STORAGE_PATH=./storage
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VALKYR Manager <no-reply@valkyr.local>
# S3 opcional. El respaldo en línea exporta los objetos a una copia portable; validar el bucket real.
S3_ENDPOINT=
S3_BUCKET=valkyr-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Producción: dominio propio; sólo cambia a HTTPS cuando el proxy esté listo.
VALKYR_HOST=
ACME_EMAIL=
CADDY_CONFIG=./infra/Caddyfile
# Bootstrap: preferir el asistente interactivo; no guardar la contraseña aquí.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=
# Backups nativos: ruta opcional a herramientas pg_dump/pg_restore/createdb.
# PG_BIN=
